# =============================================================================
# Plane CE v1.2.3 - Environment Configuration Template
# NAS: UGREEN DXP4800 Plus
# =============================================================================

# --- アプリケーション設定 ---
APP_DOMAIN=plane.aloha-88.com
WEB_URL=https://plane.aloha-88.com

# --- シークレットキー (必ず変更すること: python3 -c "import secrets; print(secrets.token_urlsafe(48))") ---
SECRET_KEY=CHANGE_ME

# --- PostgreSQL (Plane専用) ---
POSTGRES_USER=plane
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=plane

# --- RabbitMQ ---
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=CHANGE_ME

# --- Live Server ---
LIVE_SERVER_SECRET_KEY=CHANGE_ME

# --- MinIO (オブジェクトストレージ) ---
AWS_ACCESS_KEY_ID=plane-minio-access
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_S3_BUCKET_NAME=uploads

# --- ファイルサイズ上限 (デフォルト: 5MB) ---
FILE_SIZE_LIMIT=5242880
